# Copy to .env.local and fill in as needed. All are optional for local dev.

# Canonical site URL (used for metadata, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL="https://mohdalsaf.dev"

# Analytics provider: "none" | "vercel" | "plausible"
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"

# Plausible (only if NEXT_PUBLIC_ANALYTICS_PROVIDER="plausible")
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
